<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bogus" Version="35.5.1" />
		<PackageReference Include="coverlet.msbuild" Version="6.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<!-- Relational provider for the transaction-rollback tests: ExecuteInTransactionAsync
		     short-circuits on the InMemory provider, so rollback can only be proven here.
		     8.0.10 deliberately matches the EF Core version the shipped solution pins -
		     the ASP.NET Core packages moved to 8.0.30 servicing, but EF Core is its own
		     train and stays at 8.0.10 solution-wide. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<!-- StratusLive.PlatformCore requires >= 9.0.12; the EF Core 8.x graph above resolves
		     Logging.Abstractions lower, which NuGet reports as NU1605. Pin it directly (the fix
		     NU1605 itself prescribes) rather than moving off EF Core 8.0.10, which the whole
		     solution still pins (ASP.NET Core servicing moved to 8.0.30; EF Core did not). -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.12" />
		<PackageReference Include="Moq" Version="4.20.70" />
		<PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.10.0" />
		<PackageReference Update="xunit" Version="2.8.1" />
		<PackageReference Update="xunit.runner.visualstudio" Version="2.8.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<DotNetCliToolReference Include="dotnet-xunit" Version="2.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Skoruba.IdentityServer4.Admin\Skoruba.IdentityServer4.Admin.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="FluentAssertions" Version="6.12.0" />
	</ItemGroup>

</Project>

